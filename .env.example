GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback
GOOGLE_PICKER_API_KEY=your-browser-api-key
# Optional when GOOGLE_CLIENT_ID starts with the Cloud project number.
GOOGLE_CLOUD_PROJECT_NUMBER=123456789012
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-another-32-character-random-secret
SESSION_MAX_AGE_SECONDS=604800
COLLAB_APPROVAL_V2_ENABLED=false

# Migration selectors. Defaults preserve the current production behavior.
DATA_BACKEND=drive
AUTH_BACKEND=google-drive-oauth
MEDIA_BACKEND=drive
# CR10 safety controls. Keep off/blank until an explicitly authorized cutover.
FAMNESIA_MAINTENANCE_MODE=off
SUPABASE_CUTOVER_APPROVAL_ID=

# Supabase public configuration. Required only when a Supabase backend is selected.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Separate browser OAuth client used only for direct, short-lived Drive key-vault access.
VITE_GOOGLE_DRIVE_CLIENT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only admin/migration credential. Never expose through VITE_*.
SUPABASE_SECRET_KEY=

# Local development only. Production must use Upstash Redis.
SESSION_STORE_DRIVER=memory
VITE_USE_MOCK_DATA=false
# CR-05 kill switch: legacy | encrypted-synthetic | disabled. The encrypted value never falls back to plaintext APIs/drafts.
VITE_FAMILY_REPOSITORY_MODE=legacy
# Enable only on an isolated Preview database after all Supabase migrations pass.
VITE_JOIN_WORKFLOW_ENABLED=false
# Filled automatically by the Upstash integration on Vercel production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
