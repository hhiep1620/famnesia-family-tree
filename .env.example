GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback
GOOGLE_PICKER_API_KEY=your-browser-api-key
# Optional when GOOGLE_CLIENT_ID starts with the Cloud project number.
GOOGLE_CLOUD_PROJECT_NUMBER=123456789012
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-another-32-character-random-secret
SESSION_MAX_AGE_SECONDS=604800
COLLAB_APPROVAL_V2_ENABLED=false

# Local development only. Production must use Upstash Redis.
SESSION_STORE_DRIVER=memory
VITE_USE_MOCK_DATA=false
# Filled automatically by the Upstash integration on Vercel production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
