{
  "name": "famnesia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:vercel": "vercel dev",
    "dev:ui": "vite",
    "build": "tsc -b && tsc -p tsconfig.api.json && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset --local",
    "supabase:test": "supabase test db",
    "supabase:lint": "supabase db lint --local",
    "supabase:types": "supabase gen types typescript --local > src/types/database.generated.ts",
    "supabase:auth:smoke": "node scripts/supabase-auth-smoke.mjs",
    "supabase:read:smoke": "node scripts/supabase-read-smoke.mjs",
    "supabase:write:smoke": "node scripts/supabase-write-smoke.mjs",
    "supabase:media:smoke": "node scripts/supabase-media-smoke.mjs",
    "supabase:collaboration:smoke": "node scripts/supabase-collaboration-smoke.mjs",
    "test": "vitest run",
    "typecheck:api": "tsc -p tsconfig.api.json"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@e965/xlsx": "^0.20.3",
    "@forvn/vn-lunar-calendar": "^0.0.2",
    "@supabase/supabase-js": "2.112.3",
    "@upstash/redis": "^1.38.2",
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "supabase": "2.114.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
